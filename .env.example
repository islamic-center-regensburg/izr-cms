# Copy to .env (or run `node tools/init-env.mjs`, which fills random values).
DIRECTUS_PORT=8055
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DB_PASSWORD=
SECRET=

# dev (default) also loads seeds/examples; prod loads only seeds/reference.
# Set it explicitly in every deployment.
CMS_ENV=dev

# Never enable in production: publishes example seed rows that are still drafts.
SEED_PUBLISH_DEMO=false


# Static tokens of the managed service users in access/*.yaml (each name is that
# file's token_env); 32+ characters: letters, digits, - or _. Leave blank to skip a
# user. Deployed by Terraform (generated there and passed to the app as well).
SCREEN_TOKEN=
WEBSITE_TOKEN=
MCP_TOKEN=
