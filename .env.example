# dev seeds example data into empty collections; use prod for real deployments
CMS_ENV=dev
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=
SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Static token assigned to the default admin user on bootstrap. Set this
# to a fixed value (e.g. a random 32-char string) so it survives
# `make reseed` — frontends read it via DIRECTUS_READ_TOKEN and otherwise
# need regenerating after every volume wipe.
ADMIN_TOKEN=
DIRECTUS_PORT=8055
PUBLIC_URL=http://localhost:8055
